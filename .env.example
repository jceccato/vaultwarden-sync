# Copy to .env and fill in.  Do NOT commit the real .env (it holds the secret key).

# --- Scheduling (Mode A: persistent container) -----------------------------
TZ=Australia/Brisbane
SCHEDULE=0 3 * * *          # 03:00 nightly. Run a bit after your GCloud backup.
RUN_ON_START=false          # set true to also sync immediately on container start

# --- Local Vaultwarden container -------------------------------------------
CONTAINER_NAME=vaultwarden

# Host paths (Unraid). APPDATA_DIR is the live vaultwarden /data folder.
# ROLLBACK_DIR and DOWNLOAD_DIR must be OUTSIDE appdata.
APPDATA_DIR=/mnt/user/appdata/vaultwarden
ROLLBACK_DIR=/mnt/user/appdata/vaultwarden-rollback
DOWNLOAD_DIR=/mnt/user/appdata/vaultwarden-sync/downloads

# --- Google Drive (rclone) -------------------------------------------------
# Path to an rclone.conf that contains a remote pointing at your Drive.
RCLONE_CONF=/mnt/user/appdata/vaultwarden-sync/rclone.conf
RCLONE_REMOTE=gdrive        # the remote NAME inside rclone.conf
RCLONE_PATH=bw_backups      # the Drive folder == BACKUP_RCLONE_DEST on GCloud
RCLONE_EXTRA_FLAGS=         # e.g. --drive-shared-with-me  (usually leave blank)

# --- Backup encryption -----------------------------------------------------
# The openssl passphrase = BACKUP_ENCRYPTION_KEY from your GCloud .env.
# Leave blank ONLY if your backups are not encrypted (no .aes256 suffix).
# KEEP AN OFFLINE COPY of this somewhere other than the vault itself.
BACKUP_ENCRYPTION_KEY=

# --- Keeping vaultwarden up to date ----------------------------------------
# watchtower = pull + recreate (preserves Unraid template settings)  [recommended]
# pull       = only docker pull (does NOT recreate the container)
# none       = don't touch the image (e.g. you already run watchtower / CA Auto Update)
UPDATE_METHOD=watchtower
VAULTWARDEN_IMAGE=vaultwarden/server:latest

# --- Notifications (ntfy) --------------------------------------------------
# A backup that is refused (not newer than the live vault), missing,
# unreachable, stalled (older than MAX_BACKUP_AGE_HOURS) or broken is published
# here as "<NOTIFY_HOST>: Vaultwarden Backup <Refused|Missing|...>". Leave
# NTFY_URL blank to only log it. The token is a write-only publisher token: keep .env mode 600.
NTFY_URL=
NTFY_TOPIC=infra
NTFY_TOKEN=
NOTIFY_HOST=vaultwarden-sync
# The newest backup's age is read from its name, in BACKUP_TZ (blank = TZ).
MAX_BACKUP_AGE_HOURS=36
BACKUP_TZ=
